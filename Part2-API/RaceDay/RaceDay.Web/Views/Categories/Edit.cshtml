@model RaceDay.Web.Models.CategoryFormModel
@{
    var ev = (RaceDay.Web.Models.EventModel)ViewBag.Event;
    ViewData["Title"] = "Edit category";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-1">Edit category</h2>
                <div class="text-muted mb-3">@ev.EventName</div>

                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="CategoryID" />
                    <input type="hidden" asp-for="EventID" />

                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label"></label>
                        <input asp-for="CategoryName" class="form-control" />
                        <span asp-validation-for="CategoryName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaxParticipants" class="form-label"></label>
                        <input asp-for="MaxParticipants" type="number" class="form-control" />
                        <span asp-validation-for="MaxParticipants" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a class="btn btn-outline-secondary" asp-action="Index" asp-route-eventId="@Model.EventID">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}