@model List<RaceDay.Web.Models.EventModel>
@{
    ViewData["Title"] = "Upcoming events";
    var search = (string?)ViewBag.Search;
    var type = (string?)ViewBag.Type;
}

<h2 class="mb-3">Upcoming events</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label" for="search">Search by name or location</label>
                <input id="search" name="search" value="@search" class="form-control" placeholder="e.g. Zoo Lake" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="type">Event type</label>
                <select id="type" name="type" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(type))">All types</option>
                    <option value="run" selected="@(type == "run")">Run</option>
                    <option value="walk" selected="@(type == "walk")">Walk</option>
                    <option value="cycle" selected="@(type == "cycle")">Cycle</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">Filter</button>
                <a class="btn btn-outline-secondary flex-fill" asp-action="Index">Clear</a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body">
            <p class="text-muted mb-0">No upcoming events match your search.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var e in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="mb-0">@e.EventName</h5>
                            <span class="badge text-bg-dark text-capitalize">@e.EventType</span>
                        </div>
                        <div class="text-muted mb-1">@e.EventDate.ToString("dd MMM yyyy")</div>
                        <div class="mb-1">@e.Location</div>
                        <div class="mb-3">@e.Distance km</div>
                        <a class="btn btn-primary mt-auto" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventID">View event</a>
                    </div>
                </div>
            </div>
        }
    </div>
}