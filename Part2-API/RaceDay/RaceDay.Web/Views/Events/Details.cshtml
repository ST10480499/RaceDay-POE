@model RaceDay.Web.Models.EventModel
@{
    ViewData["Title"] = Model.EventName;
}

<div class="mb-3">
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Back to events</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h2 class="mb-0">@Model.EventName</h2>
            <span class="badge text-bg-dark text-capitalize">@Model.EventType</span>
        </div>

        <p class="mb-3">@Model.Description</p>

        <div class="row">
            <div class="col-md-4 mb-2">
                <div class="text-muted">Date</div>
                <div class="fw-semibold">@Model.EventDate.ToString("dd MMM yyyy")</div>
            </div>
            <div class="col-md-4 mb-2">
                <div class="text-muted">Location</div>
                <div class="fw-semibold">@Model.Location</div>
            </div>
            <div class="col-md-4 mb-2">
                <div class="text-muted">Distance</div>
                <div class="fw-semibold">@Model.Distance km</div>
            </div>
        </div>

        <div class="text-muted">Organised by @Model.OrganiserName</div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h4 class="mb-3">Categories</h4>

        @if (!Model.Categories.Any())
        {
            <p class="text-muted mb-0">The organiser has not added any categories yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Maximum participants</th>
                            <th class="text-end">Enrol</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Categories)
                        {
                            <tr>
                                <td class="fw-semibold">@c.CategoryName</td>
                                <td>@c.MaxParticipants</td>
                                <td class="text-end">
                                    <form asp-controller="Events" asp-action="Enrol" method="post" class="d-inline">
                                        <input type="hidden" name="categoryId" value="@c.CategoryID" />
                                        <input type="hidden" name="eventId" value="@Model.EventID" />
                                        <button type="submit" class="btn btn-sm btn-primary">Enrol</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>