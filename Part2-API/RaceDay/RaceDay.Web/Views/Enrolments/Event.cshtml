@model List<RaceDay.Web.Models.EnrolmentModel>
@{
    var ev = (RaceDay.Web.Models.EventModel)ViewBag.Event;
    ViewData["Title"] = "Enrolments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Enrolments</h2>
        <div class="text-muted">@ev.EventName, @ev.EventDate.ToString("dd MMM yyyy")</div>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Organiser" asp-action="Events">Back to events</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted mb-0">Nobody has enrolled in this event yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Participant</th>
                            <th>Email</th>
                            <th>Category</th>
                            <th>Enrolled on</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@e.ParticipantName</td>
                                <td>@e.ParticipantEmail</td>
                                <td>@e.CategoryName</td>
                                <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                                <td><span class="status-badge status-confirmed">Confirmed</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>