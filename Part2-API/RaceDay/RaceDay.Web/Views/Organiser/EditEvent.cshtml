@model RaceDay.Web.Models.EventFormModel
@{
    ViewData["Title"] = "Edit event";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-3">Edit event</h2>

                <form asp-action="EditEvent" method="post" enctype="multipart/form-data">
                    <partial name="_EventForm" model="Model" />

                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}